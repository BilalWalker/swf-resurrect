{
  "name": "swf-resurrect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx scripts/runTests.ts",
    "test:local-files": "tsx scripts/runLocalFiles.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:template": "tsc --noEmit -p tsconfig.template.json",
    "pipeline": "tsx src/pipeline/cli.ts",
    "gen:shim-members": "tsx scripts/gen-shim-members.ts",
    "gen:api-stubs": "tsx scripts/gen-api-stubs.ts",
    "mcp:swf-inspector": "tsx mcp/swf-inspector/main.ts",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "web:start": "tsx web/server/main.ts",
    "fetch:static-text": "tsx scripts/fetch-static-text.ts",
    "fetch:spacer": "tsx scripts/fetch-spacer.ts",
    "web": "tsx web/server/main.ts --dev",
    "web:build": "vite build --config web/client/vite.config.ts",
    "web:prewarm": "tsx web/server/prewarm.ts",
    "report:type-errors": "tsx scripts/group-type-errors.ts"
  },
  "devDependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.12.0",
    "pixi.js": "8.22.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-js": "npm:typescript@6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
